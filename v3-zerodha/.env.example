ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# India market
MARKET=INDIA
DEFAULT_EXCHANGE=NSE
WATCHLIST=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS
STARTING_CAPITAL_USD=25000
